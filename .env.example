# ============================================================
# Personal Agent Team - 环境配置
# ============================================================

# 核心配置
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-here

# MongoDB 配置
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=personal_agent_team

# 向量数据库 & Redis
VECTOR_DB_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379

# ============================================================
# LLM 多模型配置（所有提供商均使用 OpenAI 兼容接口）
# ============================================================
# 启用的提供商列表（逗号分隔），排在前面的优先级更高
LLM_PROVIDERS=qwen,deepseek,xiaomi,moonshot,zhipu,openai

# 默认提供商和模型
LLM_DEFAULT_PROVIDER=qwen
LLM_DEFAULT_MODEL=qwen-plus

# --- 任务类型 → 模型路由（可选） ---
# 格式: task_type=provider:model
LLM_ROUTE_REASONING=deepseek:deepseek-reasoner
LLM_ROUTE_CODE=deepseek:deepseek-coder
LLM_ROUTE_CHAT=qwen:qwen-turbo
LLM_ROUTE_SIMPLE=qwen:qwen-turbo

# ---- Qwen (通义千问 / DashScope) ----
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODELS=qwen-plus,qwen-turbo,qwen-max,qwen-long

# ---- DeepSeek ----
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODELS=deepseek-chat,deepseek-coder,deepseek-reasoner

# ---- Xiaomi (小米大模型) ----
XIAOMI_API_KEY=your-xiaomi-api-key
XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1
XIAOMI_MODELS=MiLM-v2-pro,MiLM-v2-flash

# ---- Moonshot (月之暗面 / Kimi) ----
MOONSHOT_API_KEY=your-moonshot-api-key
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODELS=moonshot-v1-128k,moonshot-v1-32k,moonshot-v1-8k

# ---- Zhipu (智谱 / GLM) ----
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODELS=glm-4-plus,glm-4-flash,glm-4-long

# ---- OpenAI ----
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4o,gpt-4o-mini,gpt-4-turbo

# ============================================================
# 工具 & 任务队列
# ============================================================
SEARCH_API_KEY=your-search-api-key
BROWSER_HEADLESS=true
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
